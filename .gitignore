node_modules/
*.log
.DS_Store
output/

# Generated by `rihal-code install` on this source repo — duplicates rihal/v2/ source
# .claude/ is ignored EXCEPT settings.json + hooks/*.sh (project-checked-in config)
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/*.sh
.rihal/_config/
.rihal/agents-rules/
.rihal/bin/
.rihal/config.yaml
.rihal/references/
.rihal/state.json
.rihal/workflows/

# Local artifact side-outputs (ephemeral, not committed)
.planning/council-sessions/
.planning/memory/

# Phase dirs: commit PLAN, SPRINT, VERIFICATION — ignore runtime scratch
.planning/phases/**/SUMMARY.md
.planning/phases/**/CHECK.md
.planning/phases/**/tasks/
!.planning/phases/
!.planning/phases/*/
!.planning/phases/**/*.md

# Build artifacts
dist/
image.png

# Agent-behavior eval harness (#746): raw/uncommitted eval output is
# ephemeral; normalized baselines under test/eval/baselines/ ARE committed.
test/eval/raw/
test/eval/*.raw.json

# Working scratch — external clones and plan drafts, not part of the product
temp/agent-skills/
temp/

# ===== rcode-managed gitignore block (npx @hanzlaa/rcode install) =====
# Added automatically on first rcode install. Idempotent — safe to re-run.
# Edit `commit_planning` in .rcode/config.yaml to flip planning-artifact tracking.

# Installed methodology files (regenerate with: npx @hanzlaa/rcode install)
.claude/
.rcode/bin/
.rcode/workflows/
.rcode/references/
.rcode/commands/
.rcode/skills/

# Pulled rcode brain content (refresh with: rcode brain pull)
.rcode/brain/rcode-github/
.rcode/brain/rcode-docs/
.rcode/brain/best-practices/

# Runtime noise
.rcode/state.json.lock
.planning/debug/
.planning/_backup/

# What you DO commit:
#   .rcode/config.yaml        - project mode/language/profile/commit_planning
#   .rcode/state.json         - decisions, roadmap pointer, blockers
#   .rcode/brain/sources.yaml - brain source manifest
#   .planning/                - PRD, roadmap, sprints, SUMMARY.md files
# ===== end rcode-managed gitignore block =====

# Python bytecode
__pycache__/
*.pyc
